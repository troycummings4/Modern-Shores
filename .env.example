# Copy this file to .env and fill in your real Amazon Associates tracking
# ID (get one at https://affiliate-program.amazon.com — see README.md for
# the step-by-step). Every "Shop Now" link on every product uses this
# single value, so setting it here activates real commissions site-wide.
#
# Leave it unset and the site still works for testing, but every link uses
# an unregistered placeholder tag and will NOT earn you anything.

VITE_AMAZON_ASSOCIATE_TAG=your-real-tag-20
